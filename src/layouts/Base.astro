---
import '../styles/global.css';
import ThemeScript from '../components/ThemeScript.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Texture from '../components/Texture.astro';
import Reveal from '../components/Reveal.astro';
import { getLangFromUrl, alternatePath, localizePath, withTrailingSlash } from '../i18n/utils';
import { ldJson } from '../lib/ld';
import { writingLive } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogSlug?: string;
  translated?: boolean;
}

const { title, description, ogSlug = 'home', translated = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const canonical = new URL(withTrailingSlash(Astro.url.pathname), Astro.site);
const enHref = new URL(alternatePath(Astro.url, 'en'), Astro.site);
const ptHref = new URL(alternatePath(Astro.url, 'pt'), Astro.site);
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site);
const feedHref = new URL(localizePath('/rss.xml', lang), Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alvaro Galhardo',
  url: Astro.site?.href,
  jobTitle: lang === 'pt' ? 'Engenheiro Backend' : 'Backend Engineer',
  email: 'mailto:alvaromgfernandes@gmail.com',
  sameAs: [
    'https://github.com/alvarogalhardo',
    'https://www.linkedin.com/in/alvarogalhardo'
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      translated && (
        <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="pt" href={ptHref} />
          <link rel="alternate" hreflang="x-default" href={enHref} />
        </>
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alvaro Galhardo" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {writingLive && <link rel="alternate" type="application/rss+xml" title="Alvaro Galhardo" href={feedHref} />}
    <script type="application/ld+json" is:inline set:html={ldJson(person)} />
    <slot name="head" />
  </head>
  <body>
    <Texture />
    <Header />
    <slot />
    <Footer />
    <Reveal />
  </body>
</html>
