---
import Base from './Base.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { ldJson } from '../lib/ld';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writing'>;
}
const { entry } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fmt = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  inLanguage: entry.data.lang === 'pt' ? 'pt-BR' : 'en-US',
  author: {
    '@type': 'Person',
    name: 'Alvaro Galhardo',
    url: Astro.site?.href
  }
};
---

<Base
  title={`${entry.data.title} — Alvaro Galhardo`}
  description={entry.data.summary}
  ogSlug={entry.id}
  translated={true}
  ogType="article"
  publishedTime={entry.data.date.toISOString()}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={ldJson(article)}
    slot="head"
  />
  <main class="wrap" id="top">
    <article>
      <p class="mono date">
        <time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time>
      </p>
      <h1>{entry.data.title}</h1>
      <div class="body"><slot /></div>
      <p class="mono back">
        <a href={localizePath('/writing', lang)}>&larr; {t('writing.back')}</a>
      </p>
    </article>
  </main>
</Base>

<style>
  article {
    padding-block: 80px 64px;
    max-width: 62ch;
  }
  .date {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
    text-wrap: balance;
  }
  .body :global(p) {
    margin-bottom: 20px;
    text-wrap: pretty;
  }
  .body :global(h2) {
    font-size: 26px;
    line-height: 1.3;
    margin: 40px 0 14px;
  }
  .body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid var(--line);
  }
  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .back {
    margin-top: 48px;
    font-size: 12px;
    color: var(--muted);
  }
  .back a {
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 700px) {
    article {
      padding-block: 52px 48px;
    }
  }
</style>
