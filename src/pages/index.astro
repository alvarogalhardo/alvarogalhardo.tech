---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import WritingSection from '../components/WritingSection.astro';
import ShelfSection from '../components/ShelfSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { getCollection } from 'astro:content';
import { toProjectCards, toPostCards } from '../lib/content';
import { meta } from '../data/meta';

const projects = toProjectCards(await getCollection('projects'), 'en');
const posts = toPostCards(await getCollection('writing'), 'en', 3);
---

<Base title={meta.en.home.title} description={meta.en.home.description}>
  <main class="wrap" id="top">
    <Hero />
    <ExperienceSection />
    <ProjectsSection projects={projects} />
    <WritingSection posts={posts} />
    <ShelfSection />
    <ContactSection />
  </main>
</Base>
