<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nodes = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

  function show(el: HTMLElement) {
    el.style.opacity = '1';
    el.style.transform = 'none';
  }

  function restore(el: HTMLElement) {
    el.style.opacity = '';
    el.style.transform = '';
    el.style.transition = '';
  }

  if (!reduce && 'IntersectionObserver' in window && nodes.length > 0) {
    for (const [i, el] of nodes.entries()) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(10px)';
      const delay = Math.min(i * 45, 260);
      el.style.transition =
        `opacity 620ms cubic-bezier(.22,.61,.36,1) ${delay}ms, ` +
        `transform 620ms cubic-bezier(.22,.61,.36,1) ${delay}ms`;
    }

    let alive = false;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          alive = true;
          show(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
    );

    for (const el of nodes) io.observe(el);

    window.setTimeout(() => {
      if (alive) return;
      io.disconnect();
      for (const el of nodes) restore(el);
    }, 2000);
  }
</script>
