---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { home } from '../data/copy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const copy = home[lang].hero;
---

<section class="hero">
  <p class="mono role" data-role-label>{t('hero.role')}</p>
  <h1>{copy.greeting}</h1>
  <div class="prose">
    <p class="lead">{copy.lead}</p>
    <p class="about">{copy.p1}</p>
    <p class="about">{copy.p2}</p>
  </div>
  <div class="cta mono">
    <a href="mailto:alvaromgfernandes@gmail.com" target="_blank" class="btn primary">{t('hero.cta.email')}</a>
    <a href="https://github.com/alvarogalhardo" class="btn" target="_blank" rel="me noopener noreferrer">GitHub</a>
  </div>
</section>

<style>
  .hero {
    padding-block: 34px 76px;
  }
  .role {
    margin-bottom: 22px;
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-style: bold;
  }
  h1 {
    margin-bottom: 30px;
    font-size: clamp(2.25rem, 5.4vw, 3.125rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .prose {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .lead {
    font-size: 20px;
    line-height: 1.58;
    text-wrap: pretty;
  }
  .about {
    font-size: 17px;
    line-height: 1.74;
    color: var(--muted);
    text-wrap: pretty;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
    font-size: 12px;
  }
  .btn {
    border: 1px solid var(--lineControl);
    color: var(--muted);
    padding: 10px 16px;
    border-radius: 3px;
    transition: border-color 160ms ease, color 160ms ease, background 160ms ease;
  }
  .btn:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .primary {
    border-color: var(--accent);
    color: var(--accent);
  }
  .primary:hover {
    background: var(--accent);
    color: var(--bg);
  }

  @media (max-width: 700px) {
    .hero {
      padding-block: 26px 52px;
    }
    h1 {
      line-height: 1.1;
    }
    .lead {
      font-size: 18px;
    }
    .about {
      font-size: 16px;
    }
    .btn {
      padding: 13px 16px;
    }
  }
</style>
