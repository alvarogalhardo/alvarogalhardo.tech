---
import { getLangFromUrl, useTranslations, alternatePath, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other = lang === 'en' ? 'pt' : 'en';
const home = localizePath('/', lang);
const otherHref = alternatePath(Astro.url, other);

const nav = [
  { href: `${home}#work`, label: t('nav.experience') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#writing`, label: t('nav.writing') },
  { href: `${home}#shelf`, label: t('nav.books') }
];
const drawerNav = [...nav, { href: `${home}#contact`, label: t('nav.contact') }];
---

<header>
  <div class="wrap bar mono">
    <a href={home} class="brand">
      <span class="dot" aria-hidden="true"></span><span>Alvaro</span>
    </a>

    <nav class="desktop" aria-label={t('menu.title')}>
      {nav.map((i) => <a href={i.href} class="link">{i.label}</a>)}
      <span class="sep" aria-hidden="true"></span>
      <a href={otherHref} class="chip" hreflang={other} data-lang-switch>{t('lang.toggle')}</a>
      <button type="button" class="chip" data-theme-toggle aria-label={t('theme.toggle')}>
        <span data-theme-icon aria-hidden="true">&#9790;</span>
      </button>
    </nav>

    <button type="button" class="burger" data-menu-open aria-label={t('menu.open')} aria-expanded="false" aria-controls="menu-panel">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="backdrop" data-menu-backdrop hidden></div>

<aside id="menu-panel" class="drawer" data-menu-panel aria-label={t('menu.title')} aria-hidden="true" inert>
  <div class="drawer-head">
    <span class="mono drawer-title">{t('menu.title')}</span>
    <button type="button" class="burger" data-menu-close aria-label={t('menu.close')}>
      <span class="x" aria-hidden="true">&#10005;</span>
    </button>
  </div>

  <nav aria-label={t('menu.title')}>
    {drawerNav.map((i) => <a href={i.href} class="drawer-link" data-menu-link>{i.label}</a>)}
  </nav>

  <a href={otherHref} class="drawer-row" hreflang={other}>
    <span class="drawer-row-label">{t('lang.label')}</span>
    <span class="mono drawer-row-value">{t('lang.current')}</span>
  </a>

  <button type="button" class="drawer-row" data-theme-toggle>
    <span class="drawer-row-label">{t('theme.label')}</span>
    <span class="mono drawer-row-value" data-theme-name>{t('theme.dark')}</span>
  </button>

  <p class="mono drawer-foot">&copy; {new Date().getFullYear()} Alvaro</p>
</aside>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bgFade);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 16px;
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--fg);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  nav.desktop {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--muted);
  }
  .link {
    padding-block: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms ease;
  }
  .link:hover {
    border-bottom-color: var(--accent);
  }
  .sep {
    width: 1px;
    height: 14px;
    background: var(--line);
  }
  .chip {
    font: inherit;
    letter-spacing: 0.04em;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--lineControl);
    color: var(--muted);
    padding: 4px 8px;
    border-radius: 3px;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--lineControl);
    border-radius: 3px;
    background: transparent;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: border-color 160ms ease;
  }
  .burger:hover {
    border-color: var(--accent);
  }
  .burger > span:not(.x) {
    width: 16px;
    height: 1px;
    background: var(--muted);
  }
  .x {
    color: var(--muted);
    font-size: 14px;
    line-height: 1;
  }

  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 38;
    background: oklch(0.12 0.02 252 / 0.5);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease;
  }
  .backdrop[data-open] {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 39;
    width: 82%;
    max-width: 320px;
    background: var(--bg);
    border-left: 1px solid var(--line);
    padding: 18px 22px 30px;
    display: flex;
    flex-direction: column;
    transform: translateX(103%);
    visibility: hidden;
    transition: transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1), visibility 0s linear 300ms;
  }
  .drawer[data-open] {
    transform: translateX(0);
    visibility: visible;
    transition: transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1), visibility 0s linear 0s;
    box-shadow: -24px 0 70px oklch(0 0 0 / 0.32);
  }
  .drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .drawer-title {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .drawer-link {
    display: flex;
    align-items: center;
    min-height: 50px;
    font-size: 21px;
    border-bottom: 1px solid var(--line);
  }
  .drawer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 52px;
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .drawer-row-label {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--fg);
  }
  .drawer-row-value {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .drawer-foot {
    margin-top: auto;
    padding-top: 20px;
    font-size: 11px;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .bar {
      padding-block: 12px;
      gap: 12px;
    }
    nav.desktop {
      display: none;
    }
    .burger {
      display: inline-flex;
    }
  }

  @media (min-width: 701px) {
    .backdrop,
    .drawer {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const THEME_KEY = 'av-theme';

  const NAMES = {
    en: { dark: 'Dark', light: 'Light' },
    pt: { dark: 'Escuro', light: 'Claro' }
  } as const;

  const lang = (root.lang === 'pt' ? 'pt' : 'en') as 'en' | 'pt';

  function syncThemeUI() {
    const isLight = root.dataset.theme === 'light';
    const icon = document.querySelector('[data-theme-icon]');
    if (icon) icon.textContent = isLight ? '\u2600' : '\u263E';
    const name = document.querySelector('[data-theme-name]');
    if (name) name.textContent = isLight ? NAMES[lang].light : NAMES[lang].dark;
  }

  syncThemeUI();

  for (const btn of document.querySelectorAll('[data-theme-toggle]')) {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem(THEME_KEY, next);
      } catch (e) {
        /* modo privado: o tema vale só nesta sessão */
      }
      syncThemeUI();
    });
  }

  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');

  if (openBtn && closeBtn && panel && backdrop) {
    let isOpen = false;

    function setOpen(next: boolean) {
      isOpen = next;
      panel!.toggleAttribute('data-open', next);
      backdrop!.toggleAttribute('data-open', next);
      backdrop!.hidden = !next;
      panel!.setAttribute('aria-hidden', String(!next));
      panel!.toggleAttribute('inert', !next);
      openBtn!.setAttribute('aria-expanded', String(next));
      // A trava de scroll e uma classe, nao um estilo inline: o CSS so a
      // aplica abaixo de 700px, entao voltar para desktop destrava sozinho
      // mesmo que o listener de matchMedia abaixo nao dispare.
      document.body.classList.toggle('menu-open', next);

      if (next) {
        closeBtn!.focus();
      } else {
        openBtn!.focus();
      }
    }

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));

    for (const link of document.querySelectorAll('[data-menu-link]')) {
      link.addEventListener('click', () => setOpen(false));
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) setOpen(false);
    });

    // Limpa o estado ARIA ao voltar para desktop. O scroll ja esta protegido
    // pelo CSS; isto so evita deixar aria-expanded="true" para tras.
    const desktop = window.matchMedia('(min-width: 701px)');
    desktop.addEventListener('change', (e) => {
      if (e.matches && isOpen) setOpen(false);
    });
  }
</script>
