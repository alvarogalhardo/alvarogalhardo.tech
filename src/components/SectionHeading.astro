---
interface Props {
  num: string;
  label: string;
}
const { num, label } = Astro.props;
---

<h2 class="mono heading" data-reveal>
  <span class="num" aria-hidden="true">{num}</span>
  <span>{label}</span>
  <span class="rule" aria-hidden="true"></span>
</h2>

<style>
  .heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .num {
    color: var(--accent);
  }
  .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
</style>
