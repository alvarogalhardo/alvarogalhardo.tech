---
import SectionHeading from './SectionHeading.astro';
import MetaRow from './MetaRow.astro';
import type { ProjectCardData } from '../lib/content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  projects: ProjectCardData[];
}
const { projects } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="projects" class="section">
  <SectionHeading num="02" label={t('nav.projects')} />
  <div id="projects-list">
    {
      projects.map((p) => (
        <MetaRow meta={String(p.year)} href={p.url}>
          <p class="title">
            <span class="u">{p.name}</span>
            {p.url && <span class="mono arrow" aria-hidden="true">&#8599;</span>}
          </p>
          <p class="desc">{p.summary}</p>
          <p class="mono stack">{p.stack.join(' \u00b7 ')}</p>
        </MetaRow>
      ))
    }
  </div>
</section>

<style>
  .section {
    padding-block: 16px 72px;
  }
  .title {
    font-size: 21px;
    line-height: 1.25;
    display: flex;
    align-items: baseline;
    gap: 9px;
  }
  .u {
    border-bottom: 1px solid var(--line);
  }
  .arrow {
    font-size: 12px;
    color: var(--accent);
  }
  .desc {
    max-width: 54ch;
    font-size: 16px;
    line-height: 1.66;
    color: var(--muted);
    text-wrap: pretty;
  }
  .stack {
    margin-top: 3px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--accentSoft);
  }
  @media (max-width: 700px) {
    .section {
      padding-block: 12px 52px;
    }
    .title {
      font-size: 19px;
    }
    .desc {
      font-size: 15.5px;
    }
  }
</style>
