---
import SectionHeading from './SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const line = {
  en: 'Lorem ipsum dolor sit amet \u2014 consectetur adipiscing elit sed do eiusmod tempor.',
  pt: 'Lorem ipsum dolor sit amet \u2014 consectetur adipiscing elit sed do eiusmod tempor.'
}[lang];
---

<section id="contact" class="section">
  <SectionHeading num="05" label={t('nav.contact')} />
  <p class="line" data-reveal>{line}</p>
  <div class="cta mono" id="contact-list" data-reveal>
    <a href="mailto:alvaromgfernandes@gmail.com" class="btn primary">{t('hero.cta.email')}</a>
    <a href="https://www.linkedin.com/in/alvarogalhardo" class="btn" rel="me noopener">LinkedIn</a>
    <a href="https://github.com/alvarogalhardo" class="btn" rel="me noopener">GitHub</a>
  </div>
</section>

<style>
  .section {
    padding-block: 26px 40px;
  }
  .line {
    margin-bottom: 24px;
    max-width: 40ch;
    font-size: 32px;
    line-height: 1.28;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12px;
  }
  .btn {
    border: 1px solid var(--lineControl);
    color: var(--muted);
    padding: 10px 16px;
    border-radius: 3px;
    transition: border-color 160ms ease, color 160ms ease, background 160ms ease;
  }
  .btn:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .primary {
    border-color: var(--accent);
    color: var(--accent);
  }
  .primary:hover {
    background: var(--accent);
    color: var(--bg);
  }
  @media (max-width: 700px) {
    .section {
      padding-block: 12px 34px;
    }
    .line {
      font-size: 25px;
    }
    .btn {
      padding: 13px 16px;
    }
  }
</style>
